---
import { profile } from '../content/profile';
import { buildLayouts, clientGraph } from '../content/graph';
import { disciplines } from '../content/work';
import GraphSvg from './GraphSvg.astro';

const { wide, narrow } = buildLayouts();
const clientData = clientGraph();

const stats = [
  { value: '+11%', text: 'top-20 pick quality over the best baseline, 95% CI', href: '#fpl', src: 'FPL · held-out seasons' },
  { value: '184,185', text: 'relationships in a live Neo4j knowledge graph', href: '#fpl', src: 'FPL · live, 14 Oct 2026' },
  { value: '740', text: 'synthetic evaluation runs pushed through a real ingest API', href: '#ransomware', src: 'Ransomware detection' },
  { value: '96.5%', text: 'faithfulness from a custom RAG evaluation framework', href: '#exp-advansys', src: 'Advansys internship' },
];
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker label">
        <span>{profile.role}</span><span aria-hidden="true">/</span><span>{profile.location}</span><span
          aria-hidden="true">/</span
        ><span>B.Sc. CSE, GUC {profile.gradYear}</span>
      </p>
      <h1 class="hero__name serif" id="hero-name">
        <span>Seif</span>
        <span>Moheb</span>
      </h1>
      <p class="hero__statement">
        {profile.headline.lead}
        <em class="serif">{profile.headline.turn}</em>
      </p>
      <p class="hero__intro">{profile.intro}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="#work">See the work <span aria-hidden="true">↓</span></a>
        <a class="btn" href={profile.links.resume} target="_blank" rel="noopener">Résumé PDF <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="hero__links" aria-label="Profiles">
        <li><a class="link" href={profile.links.github} rel="me noopener" target="_blank">GitHub <span class="arrow" aria-hidden="true">↗</span></a></li>
        <li><a class="link" href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a></li>
        <li><a class="link" href={`mailto:${profile.email}`}>{profile.email}</a></li>
      </ul>
    </div>

    <figure class="graph instrument" aria-labelledby="graph-caption" data-graph>
      <div class="instrument__bar">
        <span><span class="dot dot--live" aria-hidden="true"></span>&ensp;<strong>graph://seif-moheb</strong></span>
        <span>{clientData.nodes.length} nodes · {clientData.edges.length} rels</span>
      </div>

      <div class="graph__stage grid-paper">
        <div class="graph__variant graph__variant--wide"><GraphSvg layout={wide} variant="wide" /></div>
        <div class="graph__variant graph__variant--narrow"><GraphSvg layout={narrow} variant="narrow" /></div>
      </div>

      <div class="graph__filters" role="group" aria-label="Filter by discipline">
        {
          Object.entries(disciplines).map(([id, d]) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={`d:${id}`}>
              {d.label}
            </button>
          ))
        }
      </div>

      <figcaption class="graph__readout" id="graph-caption">
        <pre class="graph__query mono" data-query aria-hidden="true"><span class="kw">MATCH</span> (n) <span class="kw">RETURN</span> count(n)</pre>
        <div class="graph__result" data-result aria-live="polite">
          <p>
            {clientData.nodes.length} nodes, {clientData.edges.length} relationships. Hover, tap or tab into the graph to
            query it; the readout shows the equivalent Cypher.
          </p>
        </div>
      </figcaption>
      <script type="application/json" data-graph-json set:html={JSON.stringify(clientData)} />
    </figure>
  </div>

  <div class="wrap">
    <ul class="readouts" aria-label="Selected results">
      {
        stats.map((s) => (
          <li>
            <a href={s.href} class="readout">
              <span class="readout__value serif">{s.value}</span>
              <span class="readout__text">{s.text}</span>
              <span class="readout__src label">{s.src} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(var(--s6), 5vw, var(--s8));
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(var(--s6), 4vw, var(--s8));
    align-items: start;
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    color: var(--bone-3);
  }

  .hero__kicker span:first-child {
    color: var(--signal);
  }

  .hero__name {
    display: flex;
    flex-direction: column;
    margin-top: var(--s5);
    font-size: var(--fs-display);
    line-height: 0.86;
    letter-spacing: -0.012em;
  }

  .hero__name span:last-child {
    padding-left: 0.5em;
  }

  .hero__statement {
    max-width: 22ch;
    margin-top: var(--s6);
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2.1rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .hero__statement em {
    display: block;
    color: var(--signal);
    font-style: italic;
    font-size: 1.12em;
    line-height: 1.05;
  }

  .hero__intro {
    max-width: 52ch;
    margin-top: var(--s5);
    color: var(--bone-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    margin-top: var(--s5);
    font-size: var(--fs-small);
  }

  .hero__links li {
    min-height: 32px;
    display: flex;
    align-items: center;
  }

  /* ---------- Graph instrument ---------- */
  .graph {
    margin: 0;
  }

  .graph__stage {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .graph__variant--narrow {
    display: none;
  }

  .graph__stage {
    padding: var(--s3) var(--s4) var(--s2);
  }

  .graph__filters {
    display: none;
    flex-wrap: wrap;
    gap: 6px;
    padding: var(--s3) var(--s4);
    border-bottom: 1px solid var(--line);
  }

  .chip {
    min-height: 32px;
    padding: 0 0.75em;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--bone-3);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      color var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }

  .chip:hover {
    color: var(--bone);
    border-color: var(--line-3);
  }

  .chip[aria-pressed='true'] {
    color: var(--signal-ink);
    background: var(--sand);
    border-color: var(--sand);
  }

  .graph__readout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s3);
    min-height: 152px;
    padding: var(--s4);
  }

  .graph__query {
    margin: 0;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--bone-2);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .graph__query :global(.kw) {
    color: var(--steel);
  }

  .graph__query :global(.lb) {
    color: var(--sand);
  }

  .graph__query :global(.str) {
    color: var(--signal);
  }

  .graph__result {
    font-size: var(--fs-small);
    color: var(--bone-2);
  }

  .graph__result :global(.res-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
  }

  .graph__result :global(.res-row + .res-row) {
    margin-top: 6px;
  }

  .graph__result :global(.res-key) {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    color: var(--bone-3);
    min-width: 3.6em;
  }

  .graph__result :global(.res-go) {
    margin-top: 10px;
    display: inline-flex;
  }

  /* ---------- Readouts ---------- */
  .readouts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(var(--s7), 6vw, var(--s9));
    border-top: 1px solid var(--line-2);
  }

  .readouts li + li {
    border-left: 1px solid var(--line);
  }

  .readout {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    height: 100%;
    padding: var(--s5) var(--s5) var(--s5) 0;
    transition: background var(--t-fast) var(--ease-out);
  }

  .readouts li + li .readout {
    padding-left: var(--s5);
  }

  .readout__value {
    font-size: clamp(2.4rem, 1.8rem + 1.8vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .readout__text {
    max-width: 26ch;
    color: var(--bone-2);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .readout__src {
    margin-top: auto;
    padding-top: var(--s2);
    transition: color var(--t-fast) var(--ease-out);
  }

  .readout:hover .readout__src {
    color: var(--signal);
  }

  .readout:hover .readout__value {
    color: var(--bone);
  }

  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__statement {
      max-width: 26ch;
    }

    .graph {
      max-width: 760px;
    }

    .readouts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .readouts li + li:nth-child(odd) {
      border-left: 0;
    }

    .readouts li + li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .readouts li + li:nth-child(odd) .readout {
      padding-left: 0;
    }
  }

  @media (max-width: 640px) {
    .graph__variant--wide {
      display: none;
    }

    .graph__variant--narrow {
      display: block;
    }

    .graph__filters {
      display: flex;
    }

    .graph__stage {
      padding: var(--s3) var(--s2) var(--s2);
    }

    .readout {
      padding-right: var(--s3);
    }

    .readouts li + li:nth-child(even) .readout {
      padding-left: var(--s3);
    }
  }
</style>

<script>
  import { initGraph } from '../scripts/graph';
  const root = document.querySelector<HTMLElement>('[data-graph]');
  if (root) initGraph(root);
</script>
