---
import SectionHead from './SectionHead.astro';
import { alsoUsed, tech, techCategories, type TechId } from '../content/tech';
import { workItems } from '../content/work';

const SHORT: Record<string, string> = {
  fpl: 'FPL',
  ransomware: 'Ransomware',
  xcv: 'X-CV',
  arabic: 'Arabic QA',
  thesis: 'Thesis',
  advansys: 'Advansys',
  enpal: 'Enpal',
  dawar: 'Dawar',
};

const work = workItems.map((w) => ({ ...w, short: SHORT[w.id] ?? w.label }));
const projects = work.filter((w) => w.kind !== 'role');
const roles = work.filter((w) => w.kind === 'role');
const usedBy = (t: TechId) => work.filter((w) => w.stack.includes(t));

const groups = techCategories
  .map((cat) => ({
    cat,
    rows: (Object.keys(tech) as TechId[])
      .filter((t) => tech[t].cat === cat)
      .map((t) => ({ id: t, label: tech[t].label, users: usedBy(t) }))
      .filter((r) => r.users.length > 0)
      .sort((a, b) => b.users.length - a.users.length || a.label.localeCompare(b.label)),
  }))
  .filter((g) => g.rows.length > 0);

const toolCount = groups.reduce((n, g) => n + g.rows.length, 0);
const firstTool = groups[0]!.rows[0]!.id;

const clientData = {
  work: Object.fromEntries(
    work.map((w) => [w.id, { label: w.label, short: w.short, anchor: w.anchor, role: w.kind === 'role' }]),
  ),
};
---

<section class="section toolkit" id="toolkit" aria-labelledby="toolkit-title">
  <div class="wrap">
    <SectionHead index="03" label="Toolkit" title="Tools, and where I actually used them." id="toolkit-title">
      <p>
        No proficiency bars. Each tool links to the projects and roles where I used it, and its dots count them; for
        team projects, only my own part counts.
      </p>
    </SectionHead>

    <div class="tk" data-toolkit data-reveal>
      <div class="tk__filters">
        <div class="tk__fgroup">
          <span class="label" id="tk-projects">Projects</span>
          <div class="seg" role="group" aria-labelledby="tk-projects">
            {
              projects.map((w) => (
                <button type="button" aria-pressed="false" data-work={w.id}>
                  {w.short}
                </button>
              ))
            }
          </div>
        </div>
        <div class="tk__fgroup">
          <span class="label" id="tk-roles">Roles</span>
          <div class="seg" role="group" aria-labelledby="tk-roles">
            {
              roles.map((w) => (
                <button type="button" aria-pressed="false" data-work={w.id}>
                  {w.short}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <p class="tk__readout" data-tk-readout aria-live="polite">
        {toolCount} tools in {groups.length} areas. Pick a project or role to light up what it used, or point at a tool
        to see where I used it.
      </p>

      <div class="tk__grid" role="group" aria-label="Tools. Arrow keys move between tools." data-tk-tools>
        {
          groups.map((g) => (
            <section class="tk__group">
              <h3 class="label">{g.cat}</h3>
              <ul>
                {g.rows.map((r) => (
                  <li>
                    <button
                      type="button"
                      class="tk__tool"
                      data-tool={r.id}
                      data-used={r.users.map((u) => u.id).join(' ')}
                      tabindex={r.id === firstTool ? 0 : -1}
                    >
                      <span class="tk__name">{r.label}</span>
                      <span class="tk__dots" aria-hidden="true">
                        {r.users.map(() => (
                          <i />
                        ))}
                      </span>
                      <span class="visually-hidden">, used in {r.users.map((u) => u.short).join(', ')}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <script type="application/json" data-tk-json set:html={JSON.stringify(clientData)} />
    </div>

    <p class="toolkit__also" data-reveal>
      <span class="label">Also on the résumé</span>
      {alsoUsed.join(' · ')}
    </p>
  </div>
</section>

<style>
  .section {
    padding-top: clamp(var(--s9), 10vw, var(--s10));
  }

  .tk {
    margin-top: clamp(var(--s7), 6vw, var(--s8));
  }

  .tk__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s6);
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--line-2);
  }

  .tk__fgroup {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .tk__readout {
    min-height: 3.2em;
    padding: var(--s3) 0 var(--s5);
    color: var(--bone-2);
    font-size: var(--fs-small);
  }

  .tk__readout :global(b) {
    color: var(--bone);
    font-weight: 500;
  }

  .tk__readout :global(.tk-sep) {
    color: var(--bone-4);
  }

  /* Balanced columns: areas flow top to bottom, so short and long lists pack together. */
  .tk__grid {
    columns: 4;
    column-gap: var(--s6);
  }

  .tk__group {
    break-inside: avoid;
    margin-bottom: var(--s6);
  }

  .tk__group h3 {
    padding-bottom: var(--s2);
    border-bottom: 1px solid var(--line-2);
  }

  .tk__tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    width: 100%;
    min-height: 34px;
    padding: 0.3em 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--bone-2);
    font-size: var(--fs-small);
    line-height: 1.35;
    text-align: left;
    transition:
      color var(--t-fast) var(--ease-out),
      opacity var(--t-fast) var(--ease-out);
  }

  .tk__tool:focus-visible {
    outline-offset: 2px;
  }

  .tk__dots {
    display: inline-flex;
    flex-shrink: 0;
    gap: 3px;
  }

  .tk__dots i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--bone-4);
    transition: background var(--t-fast) var(--ease-out);
  }

  .tk__tool:hover,
  .tk__tool.is-current {
    color: var(--bone);
  }

  .tk__tool.is-current .tk__name {
    color: var(--signal);
  }

  .tk__tool.is-current .tk__dots i {
    background: var(--signal);
  }

  /* Filtering by project or role */
  .tk.is-filtering .tk__tool {
    opacity: 0.3;
  }

  .tk.is-filtering .tk__tool.is-on {
    opacity: 1;
    color: var(--bone);
  }

  .tk.is-filtering .tk__tool.is-on .tk__dots i {
    background: var(--bone-2);
  }

  /* Projects that use the tool under the pointer */
  .tk__filters :global(button.is-hot) {
    color: var(--bone);
    border-color: var(--signal);
    box-shadow: inset 0 -2px 0 var(--signal);
  }

  .toolkit__also {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s4);
    align-items: baseline;
    margin-top: var(--s7);
    color: var(--bone-2);
    font-size: var(--fs-small);
  }

  @media (max-width: 1100px) {
    .tk__grid {
      columns: 3;
    }
  }

  @media (max-width: 760px) {
    .tk__grid {
      columns: 2;
      column-gap: var(--s5);
    }
  }

  @media (max-width: 560px) {
    .tk__filters {
      gap: var(--s4);
    }

    .tk__fgroup {
      width: 100%;
    }

    .tk__tool {
      min-height: 30px;
      font-size: 0.8125rem;
    }

    .tk__group {
      margin-bottom: var(--s5);
    }
  }

  @media (max-width: 340px) {
    .tk__grid {
      columns: 1;
    }
  }
</style>

<script>
  interface WorkInfo {
    label: string;
    short: string;
    anchor: string;
    role: boolean;
  }

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  document.querySelectorAll<HTMLElement>('[data-toolkit]').forEach((root) => {
    const { work } = JSON.parse(root.querySelector('[data-tk-json]')!.textContent!) as {
      work: Record<string, WorkInfo>;
    };
    const tools = [...root.querySelectorAll<HTMLButtonElement>('[data-tool]')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-work]')];
    const readout = root.querySelector<HTMLElement>('[data-tk-readout]')!;
    const grid = root.querySelector<HTMLElement>('[data-tk-tools]')!;
    const defaultText = readout.innerHTML;

    let selected: string | null = null;
    let pinned: HTMLButtonElement | null = null;
    let current: HTMLButtonElement | null = null;

    const usedIn = (t: HTMLButtonElement) => (t.dataset.used ?? '').split(' ').filter(Boolean);
    const toolName = (t: HTMLButtonElement) => t.querySelector('.tk__name')!.textContent!.trim();

    function render() {
      root.classList.toggle('is-filtering', Boolean(selected));
      filters.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.work === selected)));
      tools.forEach((t) => {
        t.classList.toggle('is-on', Boolean(selected) && usedIn(t).includes(selected!));
        t.classList.toggle('is-current', t === current);
      });
      const hot = current ? usedIn(current) : [];
      filters.forEach((f) => f.classList.toggle('is-hot', hot.includes(f.dataset.work!)));

      if (current) {
        const links = usedIn(current)
          .map((id) => `<a class="link" href="${work[id]!.anchor}">${esc(work[id]!.label)}</a>`)
          .join('<span class="tk-sep" aria-hidden="true"> · </span>');
        readout.innerHTML = `<b>${esc(toolName(current))}</b> <span class="tk-sep" aria-hidden="true">→</span> ${links}`;
      } else if (selected) {
        const w = work[selected]!;
        const n = tools.filter((t) => usedIn(t).includes(selected!)).length;
        readout.innerHTML = `<b>${esc(w.label)}</b> used ${n} of these tools. <a class="link" href="${w.anchor}">${w.role ? 'Read about the role' : 'Open the case study'} <span class="arrow" aria-hidden="true">↓</span></a>`;
      } else {
        readout.innerHTML = defaultText;
      }
    }

    filters.forEach((f) =>
      f.addEventListener('click', () => {
        selected = selected === f.dataset.work ? null : f.dataset.work!;
        render();
      }),
    );

    // Pointer: hover previews on mouse; a tap or click pins a tool.
    tools.forEach((t) => {
      t.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        current = t;
        render();
      });
      t.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse') return;
        current = pinned;
        render();
      });
      t.addEventListener('click', () => {
        pinned = pinned === t ? null : t;
        current = pinned;
        render();
      });
      t.addEventListener('focus', () => {
        current = t;
        render();
      });
    });
    grid.addEventListener('focusout', (e) => {
      if (!grid.contains(e.relatedTarget as Node)) {
        current = pinned;
        render();
      }
    });

    // Keyboard: the tool cloud is one tab stop; arrows move, Escape clears.
    grid.addEventListener('keydown', (e) => {
      const i = tools.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      let next = -1;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = Math.min(tools.length - 1, i + 1);
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = Math.max(0, i - 1);
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = tools.length - 1;
      if (e.key === 'Escape') {
        pinned = null;
        selected = null;
        current = null;
        (document.activeElement as HTMLElement).blur();
        render();
        return;
      }
      if (next < 0) return;
      e.preventDefault();
      tools[i]!.tabIndex = -1;
      tools[next]!.tabIndex = 0;
      tools[next]!.focus();
    });
  });
</script>
