---
import SectionHead from './SectionHead.astro';
import { education, fmtRange, months, roles, type YM } from '../content/experience';

// Time strip: Jan 2024 → Jun 2026 (inclusive), with the degree as context.
const AXIS_START: YM = [2024, 1];
const AXIS_END: YM = [2026, 6];
const span = months(AXIS_START, AXIS_END);
const pos = (ym: YM) => ((months(AXIS_START, ym) - 1) / span) * 100;
const width = (a: YM, b: YM) => (months(a, b) / span) * 100;
const key = (ym: YM) => ym[0] * 12 + ym[1];
const chrono = [...roles].sort((a, b) => key(a.start) - key(b.start));

// Quarter ticks along the axis; January ticks carry the year.
const ticks: { x: number; year?: number }[] = [];
for (let y = AXIS_START[0]; y <= AXIS_END[0]; y++) {
  for (const m of [1, 4, 7, 10]) {
    if (key([y, m]) < key(AXIS_START) || key([y, m]) > key(AXIS_END)) continue;
    ticks.push({ x: pos([y, m]), year: m === 1 ? y : undefined });
  }
}
const eduEnd = pos(education.end) + width(education.end, education.end);
---

<section class="section experience" id="experience" aria-labelledby="exp-title">
  <div class="wrap">
    <SectionHead index="02" label="Experience" title="Three internships: AI engineering, data science, analytics." id="exp-title" />

    <figure class="strip" aria-labelledby="strip-cap" data-reveal>
      <figcaption class="strip__cap label" id="strip-cap">Internships, January 2024 to June 2026</figcaption>
      <div class="strip__plot">
        <div class="strip__grid" aria-hidden="true">
          {
            ticks.map((t) => (
              <span class:list={['strip__tick', { 'is-year': t.year }]} style={`left:${t.x}%`}>
                {t.year && <span class="strip__year">{t.year}</span>}
              </span>
            ))
          }
        </div>
        <div class="strip__row strip__row--edu">
          <span class="strip__lab is-end" style={`right:${100 - eduEnd}%`}>
            <span aria-hidden="true">← </span>B.Sc. CSE, GUC <span class="strip__dates mono">since Oct 2021</span>
          </span>
          <span class="strip__bar" style={`left:0;width:${eduEnd}%`}></span>
        </div>
        {
          chrono.map((r) => {
            const start = pos(r.start);
            const end = start + width(r.start, r.end);
            const alignEnd = start > 50;
            return (
              <a class="strip__row strip__row--role" href={`#exp-${r.id}`}>
                <span
                  class:list={['strip__lab', { 'is-end': alignEnd }]}
                  style={alignEnd ? `right:${100 - end}%` : `left:${start}%`}
                >
                  <span class="strip__co">{r.company}</span>
                  <span class="strip__title"> · {r.title}</span>
                  <span class="strip__dates mono">{fmtRange(r.start, r.end)}</span>
                </span>
                <span class="strip__bar" style={`left:${start}%;width:${end - start}%`} />
              </a>
            );
          })
        }
      </div>
    </figure>

    <ol class="roles">
      {
        roles.map((r) => (
          <li class="role" id={`exp-${r.id}`} data-reveal>
            <div class="role__when">
              <p class="mono role__dates">{fmtRange(r.start, r.end)}</p>
              <p class="role__meta">
                {months(r.start, r.end)} months · {r.location}
              </p>
            </div>
            <div class="role__main">
              <h3 class="role__title">
                <span class="serif role__company">
                  <a href={r.url} target="_blank" rel="noopener">
                    {r.company}
                  </a>
                  {r.companyNote && <span class="role__note">({r.companyNote})</span>}
                </span>
                <span class="role__position">{r.title}</span>
              </h3>
              <ul class="role__points">
                {r.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <ul class="tags role__stack" aria-label="Tools">
                {r.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </div>
            <dl class="role__readout">
              {r.readout.map((o) => (
                <div>
                  <dd class="serif">{o.value}</dd>
                  <dt>{o.label}</dt>
                </div>
              ))}
            </dl>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section {
    padding-top: clamp(var(--s9), 10vw, var(--s10));
  }

  /* ---------- Strip ---------- */
  .strip {
    margin: clamp(var(--s7), 6vw, var(--s8)) 0 0;
  }

  .strip__cap {
    margin-bottom: var(--s4);
  }

  .strip__plot {
    position: relative;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line-2);
  }

  .strip__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .strip__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dotted var(--line);
  }

  .strip__tick.is-year {
    border-left: 1px solid var(--line-2);
  }

  .strip__year {
    position: absolute;
    bottom: 6px;
    left: 8px;
    font-family: var(--mono);
    font-size: var(--fs-micro);
    color: var(--bone-3);
  }

  .strip__row {
    position: relative;
    display: block;
    height: 56px;
  }

  .strip__lab {
    position: absolute;
    top: 8px;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--bone);
  }

  .strip__lab.is-end {
    text-align: right;
    padding-right: 2px;
  }

  .strip__title {
    color: var(--bone-3);
  }

  .strip__dates {
    margin-left: 0.8em;
    font-size: 0.75rem;
    color: var(--bone-3);
  }

  .strip__bar {
    position: absolute;
    top: 36px;
    height: 6px;
    min-width: 6px;
    background: var(--bone-2);
    transition: background var(--t-fast) var(--ease-out);
  }

  .strip__row--role:hover .strip__bar,
  .strip__row--role:focus-visible .strip__bar {
    background: var(--signal);
  }

  .strip__row--role:hover .strip__co,
  .strip__row--role:focus-visible .strip__co {
    color: var(--signal);
  }

  .strip__row--role:focus-visible {
    outline-offset: -2px;
  }

  .strip__row--edu {
    height: 48px;
  }

  .strip__row--edu .strip__lab {
    color: var(--sand);
  }

  .strip__row--edu .strip__bar {
    top: 32px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--sand) 22%);
  }

  /* ---------- Roles ---------- */
  .roles {
    margin-top: var(--s5);
  }

  .role {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    gap: var(--s5) clamp(var(--s5), 3vw, var(--s7));
    padding: var(--s6) 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .role__dates {
    font-size: 0.875rem;
    color: var(--bone);
  }

  .role__meta {
    margin-top: var(--s1);
    color: var(--bone-3);
    font-size: 0.875rem;
  }

  .role__title {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    font-weight: 400;
  }

  .role__company {
    font-size: clamp(1.9rem, 1.5rem + 1.3vw, 2.6rem);
    line-height: 1;
  }

  .role__company a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color var(--t-fast) var(--ease-out);
  }

  .role__company a:hover {
    text-decoration-color: var(--signal);
  }

  .role__note {
    margin-left: 0.35em;
    font-size: 0.55em;
    color: var(--bone-3);
  }

  .role__position {
    font-family: var(--sans);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--bone-2);
  }

  .role__points {
    margin-top: var(--s4);
  }

  .role__points li {
    position: relative;
    padding-left: 1.2em;
    color: var(--bone-2);
  }

  .role__points li + li {
    margin-top: var(--s2);
  }

  .role__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.55em;
    height: 1px;
    background: var(--bone-3);
  }

  .role__stack {
    margin-top: var(--s4);
  }

  .role__readout {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .role__readout div {
    display: flex;
    flex-direction: column;
  }

  .role__readout dd {
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    line-height: 1;
  }

  .role__readout dt {
    margin-top: var(--s1);
    color: var(--bone-3);
    font-size: 0.875rem;
  }

  @media (max-width: 960px) {
    .role {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s3);
    }

    .role__readout {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--s6);
      order: 3;
      margin-top: var(--s3);
    }

    .role__main {
      order: 2;
    }
  }

  @media (max-width: 640px) {
    .strip__title {
      display: none;
    }

    .strip__lab {
      font-size: 0.8125rem;
    }
  }
</style>
